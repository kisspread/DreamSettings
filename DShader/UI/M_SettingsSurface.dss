#pragma material(Domain = UI, BlendMode = Translucent, ShadingModel = Unlit, Backend = Graph)
/// @asset /DreamGUI/Materials/MF_DreamUI_Shade
extern float4 DreamUIShade(float4 Tint);
/// @group Appearance @slider 0 1
uniform float FocusAmount = 0.0;
/// @group Appearance
uniform float4 BaseColour = float4(0.007,0.014,0.024,1.0);
/// @group Appearance
uniform float4 AccentColour = float4(0.12,0.55,0.62,1.0);
/// @custom
float4 SettingsSurface(float2 UV, float Focus, float3 Base, float3 Accent)
{
    float2 Size = 1.0/max(fwidth(UV),float2(0.0001,0.0001));
    float2 Half = Size*0.5;
    float2 Q = abs((UV-0.5)*Size)-Half+8.0;
    float Distance = length(max(Q,0.0))+min(max(Q.x,Q.y),0.0)-8.0;
    float Mask = 1.0-smoothstep(-0.7,0.7,Distance);
    float Border = smoothstep(-2.2,-0.6,Distance)*Mask;
    float Light = exp(-UV.x*4.0)*(0.7+0.3*(1.0-UV.y));
    float Rail = (1.0-smoothstep(3.0,4.5,UV.x*Size.x))*Focus;
    float3 Colour = Base*(1.0+0.18*(1.0-UV.y)) + Accent*(Focus*Light*0.075+Border*(0.018+0.12*Focus)+Rail*0.45);
    return float4(Colour,Mask);
}
export void M_SettingsSurface(inout material m)
{
    float4 Shaded=DreamUIShade(SettingsSurface(UE.TexCoord(Index=0),FocusAmount,BaseColour.rgb,AccentColour.rgb));
    m.EmissiveColor=Shaded.rgb;
    m.Opacity=Shaded.a;
}
